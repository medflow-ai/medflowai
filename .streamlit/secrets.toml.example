# Kopie dieser Datei als ".streamlit/secrets.toml" anlegen und Werte eintragen.
# In der Streamlit Cloud stattdessen unter "Settings → Secrets" hinterlegen.

OPENAI_API_KEY = "sk-..."

# Passwortschutz: ein gemeinsames Passwort für den Zugang zur App.
# Wird KEIN APP_PASSWORD gesetzt, ist die App offen (mit Warnhinweis).
APP_PASSWORD = "dein-zugangspasswort"

# Optional: fester Salt für den Audit-Fingerprint (sonst pro Session zufällig).
# AUDIT_SALT = "ein-langes-zufaelliges-geheimnis"
